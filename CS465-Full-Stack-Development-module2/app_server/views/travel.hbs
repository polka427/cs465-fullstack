{{> header}}

<main>
  <h2>Travel</h2>
  <section class="trips">
    {{#each trips}}
      <article class="trip">
        <img src="{{image}}" alt="{{name}}">
        <h3>{{name}}</h3>
        <p>{{description}}</p>
        <p><strong>Nights:</strong> {{nights}}</p>
        <p><strong>Price:</strong> ${{price}}</p>
      </article>
    {{/each}}
  </section>
</main>

{{> footer}}


